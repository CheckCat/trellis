# Windows launcher scripts must arrive on the user's machine with CRLF line
# endings regardless of the developer's platform or core.autocrlf setting:
# cmd.exe is documented to require CRLF in .bat files (LF-only batch files
# misbehave around multi-line blocks in particular), and a .ps1 checked out
# with LF looks broken in Notepad, which is what a non-developer user opens
# it with. Repository storage stays LF (the `text` attribute normalizes on
# commit) — only the checkout is CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF everywhere, including a checkout on Windows with
# core.autocrlf=true: `docker/postgres/init/00-init.sh` is mounted straight
# into a Linux container (a CRLF shebang there is a broken container), and
# `scripts/stack/*.sh` are run by sh on macOS/Linux and by WSL/Git Bash on a
# developer's Windows machine.
*.sh text eol=lf

{
  "name": "trellis",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/stack/stack.mjs start",
    "stack:rebuild": "node scripts/stack/stack.mjs rebuild",
    "stack:down": "node scripts/stack/stack.mjs down",
    "lint": "npm run lint --workspaces --if-present && eslint tests scripts",
    "build": "npm run build --workspaces --if-present && tsc -p tests/e2e/tsconfig.json",
    "capabilities:write": "npm run capabilities:write --workspace @trellis/backend",
    "capabilities:check": "npm run capabilities:check --workspace @trellis/backend",
    "course:lint": "npm run course:lint --workspace @trellis/backend --",
    "pretest": "node scripts/check-text-sources.mjs",
    "test": "npm run test --workspaces --if-present && node --test scripts/*.test.mjs",
    "pretest:e2e": "tsc -p tests/e2e/tsconfig.json",
    "test:e2e": "node --test 'tests/e2e/dist/**/*.test.js'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}

{
  "name": "@trellis/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test 'dist-test/**/*.test.js'",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "dev": "npm run build && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/server.js)"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1"
  }
}

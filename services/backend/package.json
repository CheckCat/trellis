{
  "name": "@trellis/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test 'dist-test/**/*.test.js'",
    "lint": "eslint .",
    "start": "node dist/server/server.js",
    "dev": "npm run build && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/server/server.js)",
    "precapabilities:write": "tsc -p tsconfig.json",
    "capabilities:write": "node dist/capabilities-cli.js write",
    "precapabilities:check": "tsc -p tsconfig.json",
    "capabilities:check": "node dist/capabilities-cli.js check",
    "precourse:lint": "tsc -p tsconfig.json",
    "course:lint": "node dist/course-lint-cli/course-lint-cli.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1"
  }
}

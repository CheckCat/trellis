{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src"],
  // Production build only: test files are compiled separately (see
  // tsconfig.test.json) into dist-test/, never into dist/ — dist/ is what
  // the Dockerfile copies into the runtime image (fix round 1, task-003
  // report).
  "exclude": ["src/**/*.test.ts"]
}

# Trellis — переменные окружения для локального docker compose.
# Скопируй этот файл в .env (`cp .env.example .env`) и подставь свои значения.
# .env в git не попадает (см. .gitignore) — секреты здесь только у тебя на диске.
#
# ВНИМАНИЕ — пароли ниже фиксируются НАВСЕГДА при самом первом запуске:
# `docker compose up` создаёт роли Postgres с этими паролями один раз, при
# первой инициализации пустого тома данных. Если после этого поменять
# POSTGRES_PASSWORD / APP_DB_PASSWORD / SANDBOX_DB_PASSWORD в .env и
# перезапустить стек — Postgres продолжит требовать СТАРЫЙ пароль (роль уже
# создана, повторной инициализации не происходит), и backend уйдёт в
# бесконечный рестарт с "password authentication failed".
#
# Чинится без потери данных: `./scripts/stack/start.sh --sync-passwords`
# (Windows: `.\scripts\stack\start.ps1 -SyncPasswords`) — команда приводит
# пароли ролей внутри базы к тем, что сейчас здесь. Проще, впрочем,
# подставить значения ниже ДО первого запуска и больше их не трогать.

# --- Postgres --------------------------------------------------------------

# Пароль суперпользователя postgres (используется только init-скриптами при
# первом старте контейнера — не роль приложения).
POSTGRES_PASSWORD=change-me-postgres-superuser

# Пароль роли ядра платформы (trellis_app, владелец схемы core).
APP_DB_PASSWORD=change-me-app-role

# Пароль роли песочницы практики (trellis_sandbox, владелец схемы sandbox).
SANDBOX_DB_PASSWORD=change-me-sandbox-role

# Порт Postgres на хосте (только 127.0.0.1). Меняй, если 5433 занят.
POSTGRES_PORT=5433

# --- Backend / Frontend ------------------------------------------------------

# Порт backend API на хосте (только 127.0.0.1). Меняй, если 3001 занят.
BACKEND_PORT=3001

# Порт веб-интерфейса на хосте (только 127.0.0.1). Меняй, если 3000 занят.
FRONTEND_PORT=3000
